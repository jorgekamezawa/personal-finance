# ADR-0016: mesma origem para app e API; HTTP puro atrás da rede privada.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# A API vem antes do arquivo estático: /api nunca é procurado no disco.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# O casco do app nunca entra em cache longo (ADR-0007).
		@sem-cache path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @sem-cache Cache-Control "no-cache"
		# O resto leva identificador no nome e pode ficar guardado.
		@com-hash path /assets/*
		header @com-hash Cache-Control "public, max-age=31536000, immutable"

		# Desvio para a página inicial só em navegação e só quando o arquivo não existe:
		# assim um script inexistente responde 404, e não HTML (ADR-0016).
		@navegacao {
			not path /assets/*
			header Accept *text/html*
			not file
		}
		rewrite @navegacao /index.html
		file_server
	}
}
