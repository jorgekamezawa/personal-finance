# Same origin for app and API. Plain HTTP: TLS is terminated by the private network.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# The API comes first so /api is never looked up on disk.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# The app shell must never be cached long: these files carry no hash.
		@sem-cache path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @sem-cache Cache-Control "no-cache"

		@com-hash path /assets/*
		header @com-hash Cache-Control "public, max-age=31536000, immutable"

		# Fallback only for navigation and only when the file is missing, so a missing
		# script answers 404 instead of HTML.
		@navegacao {
			not path /assets/*
			header Accept *text/html*
			not file
		}
		rewrite @navegacao /index.html
		file_server
	}
}
